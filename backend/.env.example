# =====================================================
# Backend - EETP N° 602
# Copiar este archivo a ".env" y ajustar valores
# =====================================================

# Puerto del servidor
PORT=3000

# Secreto para firmar los JWT (CAMBIAR en producción)
JWT_SECRET=prime-dev-2026-cambiar-esto-en-produccion

# Expiración del token (ej: 8h, 1d)
JWT_EXPIRES_IN=8h

# Ruta a la base SQLite (relativa a backend/)
DB_PATH=./data/app.db

# Entorno
NODE_ENV=development

# CORS: origen permitido del frontend (Angular dev)
CORS_ORIGIN=http://localhost:4200